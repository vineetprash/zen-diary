<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:gravity="center"
    android:orientation="vertical" android:padding="10dp">
    <TextView android:id="@+id/widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/widget_title" android:textColor="@color/widget_text" android:textSize="13sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="6dp" android:gravity="center" android:orientation="horizontal">
        <ImageView android:id="@+id/mood_1" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:padding="3dp" android:src="@drawable/mood_1" android:contentDescription="Mood 1"/>
        <ImageView android:id="@+id/mood_2" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:padding="3dp" android:src="@drawable/mood_2" android:contentDescription="Mood 2"/>
        <ImageView android:id="@+id/mood_3" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:padding="3dp" android:src="@drawable/mood_3" android:contentDescription="Mood 3"/>
        <ImageView android:id="@+id/mood_4" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:padding="3dp" android:src="@drawable/mood_4" android:contentDescription="Mood 4"/>
        <ImageView android:id="@+id/mood_5" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:padding="3dp" android:src="@drawable/mood_5" android:contentDescription="Mood 5"/>
    </LinearLayout>
</LinearLayout>
